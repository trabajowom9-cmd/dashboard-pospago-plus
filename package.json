{
  "name": "pospagos-plus-mall-ibague",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Uso de herramienta pospagos PLUS - Mall Ibagué: dashboard de solo lectura sobre Google Sheets",
